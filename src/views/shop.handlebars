<div class="container py-5">

    <!-- CABECERA TIENDA -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-5 pb-3 border-bottom gap-3">
        <div>
            <h2 class="fw-bold mb-1 text-dark">
                <i class="bi bi-grid-fill me-2 text-primary"></i>Catálogo de Productos
            </h2>
            <p class="text-muted mb-0">Explora nuestra selección exclusiva de artículos disponibles</p>
        </div>

        <div class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle px-3 py-2 rounded-pill fw-semibold align-self-start align-self-md-auto">
            <i class="bi bi-box-seam me-1"></i> {{products.length}} Productos disponibles
        </div>
    </div>

    {{#if products.length}}
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        {{#each products}}
        <div class="col">
            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden position-relative product-card transition-all">
                <div class="position-relative bg-light overflow-hidden" style="height: 220px;">
                    {{#if this.imageUrl}}
                    <img src="{{this.imageUrl}}" 
                        class="w-100 h-100 object-fit-cover product-img" 
                        alt="{{this.name}}" 
                        onerror="this.onerror=null; this.parentElement.innerHTML='<div class=\'w-100 h-100 d-flex flex-column align-items-center justify-content-center bg-light text-muted\'><i class=\'bi bi-image display-5 opacity-50 mb-1\'></i><span class=\'small fw-semibold\'>Sin imagen</span></div>';"
                    >
                    {{else}}
                    <div class="w-100 h-100 d-flex flex-column align-items-center justify-content-center bg-light text-muted">
                        <i class="bi bi-image display-5 opacity-50 mb-1"></i>
                        <span class="small fw-semibold">Sin imagen</span>
                    </div>
                    {{/if}}
              
                    <span class="position-absolute top-0 end-0 m-3 badge bg-white text-dark shadow-sm border rounded-pill px-2 py-1 fw-bold" style="font-size: 0.75rem;">
                        {{formatCLP this.price}}
                    </span>
                </div>

                <!-- CUERPO TARJETA -->
                <div class="card-body d-flex flex-column p-4">
                    <h5 class="card-title fw-bold text-dark text-truncate mb-2" title="{{this.name}}">{{this.name}}</h5>
                    <p class="card-text text-muted small flex-grow-1 mb-3" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; text-overflow: ellipsis;" title="{{this.description}}">
                        {{this.description}}
                    </p>

                    <div class="d-flex align-items-center justify-content-between bg-light rounded-3 p-1 mb-3 border">
                        <span class="small text-muted fw-semibold ps-2">Cant:</span>
                        <div class="input-group input-group-sm w-50 quantity-selector">
                            <button class="btn btn-outline-secondary border-0 btn-minus px-2" type="button">
                                <i class="bi bi-dash"></i>
                            </button>
                            <input type="number" class="form-control text-center bg-transparent border-0 fw-bold shadow-none p-0 product-qty" value="1" min="1" max="99" readonly>
                            <button class="btn btn-outline-secondary border-0 btn-plus px-2" type="button">
                                <i class="bi bi-plus"></i>
                            </button>
                        </div>
                    </div>

                    <button 
                        class="btn btn-primary w-100 rounded-3 py-2 fw-semibold shadow-sm add-to-cart-btn d-flex align-items-center justify-content-center gap-2" 
                        data-id="{{this.id}}" 
                        data-name="{{this.name}}" 
                        data-price="{{this.price}}"
                        data-image="{{this.imageUrl}}"
                        >
                        <i class="bi bi-cart-plus fs-5"></i> Añadir al Carrito
                    </button>
                </div>
            </div>
        </div>
        {{/each}}
    </div>

    {{else}}
    <div class="row justify-content-center my-5">
        <div class="col-12 col-md-8 col-lg-6 text-center py-5">
            <div class="p-5 bg-white rounded-4 shadow-sm border">
                <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex p-4 mb-3">
                    <i class="bi bi-inbox display-4"></i>
                </div>
                <h4 class="fw-bold text-dark mb-2">Sin productos disponibles</h4>
                <p class="text-muted mb-0">Por el momento no hay artículos registrados en el catálogo. Vuelve a consultar más tarde.</p>
            </div>
        </div>
    </div>
    {{/if}}
</div>

<script src="/assets/js/shop.js"></script>