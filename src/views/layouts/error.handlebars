<!DOCTYPE html>
<html lang="es" data-bs-theme="light">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{{#if title}}{{title}} - Enterprise Core{{else}}Error - CoreApp Enterprise{{/if}}</title>
    
        {{> vendors}}
    
        <link rel="stylesheet" href="/assets/css/styles.css">
    </head>
    <body class="d-flex flex-column min-vh-100 bg-light">

        <!-- HEADER -->
        <header class="bg-white border-bottom py-3 shadow-sm">
            <div class="container text-center text-md-start">
                <a class="navbar-brand d-inline-flex align-items-center gap-2 text-decoration-none" href="/">
                    <i class="bi bi-cpu-fill text-primary fs-4"></i>
                    <span class="fw-bold text-dark fs-5">CoreApp <small class="fw-normal text-muted">Enterprise</small></span>
                </a>
            </div>
        </header>

        <!-- CONTENIDO VISTA ERROR -->
        <main class="main-content py-5 flex-grow-1 d-flex align-items-center">
            <div class="container">
                {{{body}}}
            </div>
        </main>

        {{> footer}}

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    </body>
</html>