<div class="container py-4">
    <div class="row g-4">
    
        {{> sidebar}}

        <!-- MAIN DASHBORAD -->
        <main class="col-12 col-md-9 col-xl-9">
      
            <!-- HERO HEADER -->
            <div class="card border-0 shadow-sm rounded-4 bg-primary text-white p-4 p-md-5 mb-4">
                <div class="row align-items-center">
                    <div class="col-lg-12">
                        <span class="badge bg-white text-primary mb-3 px-3 py-2 fw-bold">
                            <i class="bi bi-shield-check me-1"></i> Plataforma de Control
                        </span>
                        <h1 class="display-6 fw-bold mb-2">Sistema de Gestión Centralizada</h1>
                        <p class="lead opacity-75 mb-0">
                            Monitoreo modular de alto rendimiento. Control de catálogo, perfiles de usuario y trazabilidad en tiempo real.
                        </p>
                    </div>
                </div>
            </div>

            <!-- METRICS GRID -->
            <div class="row g-3 mb-4">
                <div class="col-sm-6 col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                        <div class="d-flex align-items-center">
                            <div class="p-3 bg-primary bg-opacity-10 text-primary rounded-4 me-3">
                                <i class="bi bi-diagram-3 fs-4"></i>
                            </div>
                            <div>
                                <span class="text-muted small fw-semibold text-uppercase">Arquitectura</span>
                                <h6 class="fw-bold mb-0">Modular MVC</h6>
                                <small class="text-success fw-medium"><i class="bi bi-check-circle-fill me-1"></i> Express</small>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-sm-6 col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                        <div class="d-flex align-items-center">
                            <div class="p-3 bg-success bg-opacity-10 text-success rounded-4 me-3">
                                <i class="bi bi-file-earmark-text fs-4"></i>
                            </div>
                            <div>
                                <span class="text-muted small fw-semibold text-uppercase">Persistencia</span>
                                <h6 class="fw-bold mb-0">fs/promises</h6>
                                <small class="text-success fw-medium"><i class="bi bi-check-circle-fill me-1"></i> Log Activo</small>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-sm-12 col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                        <div class="d-flex align-items-center">
                            <div class="p-3 bg-info bg-opacity-10 text-info rounded-4 me-3">
                                <i class="bi bi-cpu fs-4"></i>
                            </div>
                            <div>
                                <span class="text-muted small fw-semibold text-uppercase">Servidor</span>
                                <h6 class="fw-bold mb-0">Online</h6>
                                <small class="text-success fw-medium"><i class="bi bi-broadcast me-1"></i> Puerto Activo</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <h5 class="fw-bold mb-3">Acciones Rápidas</h5>
                <div class="d-flex flex-wrap gap-2">
                    <a href="/admin/users" class="btn btn-primary rounded-3 px-4 py-2 fw-semibold">
                        <i class="bi bi-people-fill me-2"></i> Administrar Usuarios
                    </a>
                    <a href="/admin/status" class="btn btn-outline-secondary rounded-3 px-4 py-2 fw-semibold">
                        <i class="bi bi-activity me-2"></i> Métricas del Sistema
                    </a>
                </div>
            </div>
        </main>
    </div>
</div>