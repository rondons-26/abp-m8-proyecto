<div class="container py-4">
    <div class="row g-4">
    
        {{> sidebar}}

        <!-- CONTENIDO PRINCIPAL -->
        <main class="col-12 col-md-9 col-xl-9">
            <div class="card border-0 shadow-sm rounded-4 bg-primary text-white py-3 px-4 mb-4">
                <div class="d-flex flex-column">
                    <span class="badge bg-white text-primary mb-2 px-2 py-1 fw-bold align-self-start" style="font-size: 0.75rem;">
                        <i class="bi bi-shield-check me-1"></i> Plataforma de Control
                    </span>
                    <h1 class="fs-4 fw-bold mb-1">Estado del Servidor</h1>
                    <p class="small opacity-75 mb-0">
                        Monitoreo en tiempo real de la instancia Node.js y Express.
                    </p>
                </div>
            </div>

            <div class="card border-0 rounded-4 shadow-sm p-4 bg-white">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="p-3 border rounded-3 bg-light">
                            <span class="text-muted small d-block mb-1">ESTADO OPERATIVO</span>
                            <span class="fw-bold text-success fs-5">● {{status.status}}</span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="p-3 border rounded-3 bg-light">
                            <span class="text-muted small d-block mb-1">TIEMPO ACTIVO (UPTIME)</span>
                            <span class="fw-bold text-dark fs-5">{{status.uptime}}</span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="p-3 border rounded-3 bg-light">
                            <span class="text-muted small d-block mb-1">ENTORNO</span>
                            <span class="fw-bold text-dark fs-5">{{status.environment}}</span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="p-3 border rounded-3 bg-light">
                            <span class="text-muted small d-block mb-1">VERSIÓN DE NODE</span>
                            <span class="fw-bold text-dark fs-5">{{status.nodeVersion}}</span>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>